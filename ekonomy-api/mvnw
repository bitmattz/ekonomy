#!/bin/sh
# Maven Wrapper startup script - standard 3.x format

set -e

# Resolve script directory to absolute path
if [ -n "$BASH_SOURCE" ]; then
  THIS_DIR="$(dirname "$BASH_SOURCE")"
else
  THIS_DIR="$(dirname "$0")"
fi
MAVEN_PROJECTBASEDIR="$(cd "$THIS_DIR" && pwd)"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"

# Determine java executable
if [ -z "$JAVA_HOME" ]; then
  JAVA_CMD="$(which java 2>/dev/null)"
  if [ -z "$JAVA_CMD" ]; then
    echo "Error: JAVA_HOME is not set and no java found in PATH." >&2
    exit 1
  fi
  # Dereference symlinks to find real JAVA_HOME
  while [ -h "$JAVA_CMD" ]; do
    JAVA_CMD="$(readlink "$JAVA_CMD")"
  done
  JAVA_HOME="$(dirname "$(dirname "$JAVA_CMD")")"
fi

JAVA_CMD="$JAVA_HOME/bin/java"

if [ ! -x "$JAVA_CMD" ]; then
  echo "Error: Java executable not found at: $JAVA_CMD" >&2
  exit 1
fi

exec "$JAVA_CMD" \
  -classpath "$MAVEN_WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
